{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://dholera-backend-epb9.onrender.com/api/$1"
    },
    {
      "source": "/((?!assets|logo.png|robots.txt|sitemap.xml|manifest.webmanifest|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

